# ServiceBid Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# For local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/servicebid
# For Neon cloud (production):
#   DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/servicebid?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/servicebid

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long, random, unique string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
